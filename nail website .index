
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Polished by Mel | Designed to Shine </title>
	<!-- Google Fonts-->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
	<!-- FontAwesome Icons -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	
	<style>
		/* ---CSS VARIABLES (Pink Aesthetic Palette) --- */
		:root {
			--bg-light: #fff0f5;	   /*Lavender blush background */
			--bg-card: #ffffff;
			--primary-pink: #f48fb1;   /*Soft Rose Pink */
			--dark-pink: #f48fb1;	   /*Deep Fuchsia Accent */
			--accent-pink: #fce4ec;	   /*Very soft pink */
			--text-dark: #33222a;	   /*Deep berry charcoal */
			--text-muted: #7a5c68; 
			--border-color: #f8bbd0;
			--shadow: 0 10px 30px rgba(216, 27, 96, 0.08);
			--radius: 16px;
		}
		
		/* --- GLOBAL STYLES --- */
		*{
			margin: 0;
			padding: 0;
			box-sizing: border-box;
			font-family: 'Poppins', sans-serif;
		}
		
		body {
			background-color: var(--bg-light);
			color: var(--text-dark);
			line-height: 1.6;
			scroll-behavior: smooth;
		}
		
		h1, h2, h3, h4, .brand-font {
			font-family: 'Playfair Display', serif;
		}
		
		a{
			text-decoration: none;
			color: inherit;
		}
		
		.container {
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 20px;
		}
		
		.btn {
			display: inline-block;
			background: linear-gradient(135deg, var(--dark-pink), var(--primary-pink));
			color: white;
			padding: 12px 30px;
			border-radius: 30px;
			font-weight: 500;
			letter-spacing: 0.5px;
			border: none;
			cursor: pointer;
			transition: all 0.3s ease;
			box-shadow: 0.4px 15px rgba(216, 27, 96, 0.25);
		}
		
		.btn:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 20px rgba(216, 27, 96, 0.35);
		}
		
		.btn-outline {
			background: transparent;
			color: var(--dark-pink);
			border: 2px solid var(--dark-pink);
			box-shadow: none;
		}
		
		.btn-outline:hover {
			background: var(--dark-pink);
			color: white;
		}
		
		.section-header {
			text-align: center;
			margin-bottom: 50px;
		}
		
		.section-header h2 {
			font-size: 2.5rem;
			color: var(--dark-pink);
			margin-bottom: 10px;
		}
		
		.section-header p {
			color: var(--text-muted);
			font-size: 1.05rem;
		}
		
		/*--- NAVIGATION ---*/
		header {
			background-color: rgba(255, 255, 255, 0.9);
			backdrop-filter: blur(10px);
			position: sticky;
			top: 0;
			z-index: 1000;
			box-shadow: 0 2px 20px rgba(0,0,0,0.04);
		}
		
		.navbar{
			display:flex;
			justify-content: space-between;
			align-items: center;
			padding: 20px 0;
		}
		
		.logo{
			font-size: 1.8rem;
			font-weight: 700;
			color: var(--dark-pink);
		}
		
		.logo span {
			color: var(--primary-pink);
			font-style: italic;
		}
		
		.nav-links {
			display: flex;
			list-style: none;
			gap: 30px;
			align-items: center;
		}
		
		.nav-links a{
			font-weight: 500;
			transition: color 0.3s;
		}
		
		.nav-links a:hover {
			color: var(--dark-pink);
		}
		
		/*--- HERO SECTION ---*/
		.hero {
			padding: 100px 0 80px;
			background: radial-gradient(circle at top right, #fce4ec, transparent 60%);
		}
		
		.hero-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 50px;
			align-items: center;
		}
		
		.hero-text h1{
			font-size: 3.5rem;
			line-height: 1.3;
			color: var(--dark-pink);
			margin-bottom: 20px;
		}
		
		.hero-text p{
			font-size: 1.1rem;
			color: var(--text-muted);
			margin-bottom: 30px;
		}
		
		.hero-buttons{
			display: flex;
			gap: 15px;
		}
		
		.hero-card{
			background: var(--bg-card);
			padding: 30px;
			border-radius: var(--radius);
			box-shadow: var(--shadow);
			border: 1px solid var(--border-color);
			position: relative;
		}
		
		.badge {
			position: absolute;
			top: -15px;
			right: 20px;
			background: var(--dark-pink);
			color: white;
			padding: 5px 15px;
			border-radius: 20px;
			font-weight: 600;
		}
		
		/*---SERVICES SECTION ---*/
		.services {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 30px;
		}
		
		.service-card {
			background: var(--bg-card);
			border-radius: var(--radius);
			padding: 35px 25px;
			box-shadow: var(--shadow);
			border: 1px solid rgba(248, 187, 208, 0.4);
			text-align: center;
			transition: transform 0.3s ease;
		}
		
		.service-card:hover {
			transform: translateY(-5px);
		}
		
		.service-icon {
			width: 70px;
			height: 70px;
			background: var(--accent-pink);
			color: var(--dark-pink);
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0 auto 20px;
			font-size: 1.8rem;
		}
		
		.service-card h3{
			font-size: 1.4rem;
			margin-bottom: 10px;
		}
		
		.service-card p{
			color: var(--text-muted);
			font-size: 0.9rem;
			margin-bottom: 20px;
		}
		
		.price{
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--dark-pink);
		}
		
		/* --- BOOKING & APPOINTMENTS---*/
		.booking{
			padding: 80px 0;
			background: #fff;
		}
		
		.booking-container {
			background: var(--bg-light);
			border-radius: var(--radius);
			padding: 40px;
			box-shadow: var(--shadow);
			border: 1px solid var(--border-color);
			max-width: 800px;
			margin: 0 auto;
		}
		
		.booking-form {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 20px;
		}
		
		.form-group {
			display: flex;
			flex-direction: column;
			gap: 8px;
		}
		
		.form-group.full-width{
			grid-column: span 2;
		}
		
		.form-group label{
			font-weight: 500;
			font-size: 0.9rem;
			color: var(--text-dark);
		}
		
		.form-group input,
		.form-group select,
		.form-group textarea {
			padding: 12px 15px;
			border: 1px solid var(--border-color);
			border-radius: 10px;
			font-size: 0.95rem;
			outline: none;
			transition: border-color 0.3s;
		}
		
		.form-group input:focus,
		.form-group select:focus,
		.form-group textarea:focus {
			border-color: var(--dark-pink);
		}
		
		/* --- CONTACT & INFO SECTION --- */
		.contact {
			padding: 80px 0;
		}
		
		.contact-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 40px;
		}
		
		.contact-info-box {
			background: var(--bg-card);
			padding: 35px;
			border-radius: var(--radius);
			box-shadow: var(--shadow);
		}
		
		.info-item {
			display: flex;
			align-items: flex-start;
			gap: 20px;
			margin-bottom: 25px;
		}
		
		.info-item i {
			font-size: 1.4rem;
			color: var(--dark-pink);
			background: var(--accent-pink);
			padding: 12px;
			border-radius: 10px;
		}
		
		.info-item h4 {
			font-size: 1.1rem;
			margin-bottom: 3px;
		}
		
		.info-item p {
			color: var(--text-muted);
			font-size: 0.95rem;
		}
		
		.social-links{
			display: flex;
			gap: 15px;
			margin-top: 30px;
		}
		
		.social-links a {
			width: 45px;
			height: 45px;
			border-radius: 50%;
			background: var(--accent-pink);
			color: var(--dark-pink);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.2rem;
			transition: all 0.3s;
		}
		
		.social-links a:hover {
			background: var(--dark-pink);
			color: white;
			transform: translateY(-3px);
		}
		
		/* ---FOOTER ---*/
		footer {
			background: var(--text-dark);
			color: white;
			text-align: center;
			padding: 30px 0;
			font-size: 0.9rem;
		}
		
		footer span {
			color: var(--primary-pink);
		}
		
		/* ---RESPONSIVE DESIGN --- */
		@media (max-width: 769px) {
			.hero-grid,
			.contact-grid,
			.booking-form {
				grid-template-columns: 1fr;
			}
			
			.form-group.full-width {
				grid-column: span 1;
			}
			
			.nav-links {
				display: none; /* Can be expanded into a mobile drawer if needed */
			}
			.hero-text h1 {
				font-size: 2.5rem;
			}
		}
	</style>
</head>
<body>

	<!--NAVBAR -->
	<header>
		<div class="container navbar">
			<a href="#" class="logo">Polished <span>by Mel</span></a>
			<ul class="nav-links">
				<li><a href="#about">About</a></li>
				<li><a href="#services">Services</a></li>
				<li><a href="#contact">Contact</a></li>
				<li><a href="#book" class="btn"> Book Now</a></li>
			</ul>
		</div>
	</header>
	
	<!--HERO SECTION-->
	<section class="hero" id="about">
		<div class="container hero-grid">
			<div class="hero-text">
				<h1>Elevate Your Beauty & Nail Care</h1>
				<p>Welcome to <strong>Polished by Mel</strong>. Experience beautiful custom art designs in a chic pink atmosphere.</p>
				<div class="hero-buttons">
					<a href="#Services" class="btn btn-outline">View Menu</a>
				</div>
			</div>
			<div class="hero-card">
				<span class="badge">Special Offer</span>
				<h3>First Time Booking</h3>
				<p style="color: var(--text-muted); margin: 10px 0 20px;">Get 15% off your first full acrylic set or gel manicure with Mel.</p>
				<a href="#book" class="btn" style="width: 100%; text-align: center;"> Claim Discount</a>
			</div>
		</div>
	</section>
	
	<!-- SERVICES SECTION -->
	<section class="services" id="Services">
		<div class="container">
			<div class="section-header">
				<h2>Our Services</h2>
				<p>Custom nail sets, gel overlays, and restorative care</p>
			</div>
			<div class="service-grid">
				<!--Service 1-->
				<div class="service-card">
					<div class="service-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
					<h3>Custom Gel Full Set</h3>
					<p>Includes shape prep, cuticle care, custom gel polish, and lightweight nail art.</p>
					<div class="price">$25+</div>
				</div>
				<!--Service 2-->
				<div class="service-card">
					<div class="service-icon"><i class="fa-solid fa-gem"></i></div>
					<h3>Freestyle Luxury Set</h3>
					<p>Full creative freedom by Mel featuring 3D charms, French tips, or chrome details.</p>
					<div class="price">$40+</div>
				</div>
				<!--Service 3-->
				<div class="service-card">
					<div class="service-icon"><i class="fa-solid fa-hand-sparkles"></i></div>
					<h3>Structure Gel Overlays</h3>
					<p>Reinforce natural nails with a durable builder gel overlay and high-shine finish.</p>
					<div class="price">$15+</div>
				</div>
			</div>
		</div>
	</section>
	
	<!-- APPOINTMENT BOOKING SECTION-->
	<section class="booking" id="book">
		<div class="container">
			<div class="section-header">
				<h2>Book Your Appointment</h2>
				<p>Reserve your slot with Mel in just a few clicks</p>
			</div>
			<div class="booking-container">
				<form class="booking-form" onsubmit="handleBooking(event)">
					<div class="form-group">
						<label for="name">Full Name</label>
						<input type="text" id="name" placeholder="Sarah Lopez" required>
					</div>
					<div class="form-group">
						<label for="phone">Phone Number</label>
						<input type="tel" id="phone" placeholder="(555) 000-0000" required>
					</div>
					<div class="form-group">
						<label for="date">Preferred Date & Time</label>
						<input type="date" id="date" required>
						<input type="time" id="time" required>
					</div>
					<div class="form-group">
						<label for="service">Select Service</label>
						<select id="service" required>
							<option value="">Choose a Service...</option>
							<option value="gel-set">Custom Gel Full Set ($25+)</option>
							<option value="Freestyle">Freestyle Luxury Set ($40+)</option>
							<option value="overlay">Structure Gel Overlay ($15+)</option>
						</select>
					</div>
					<div class="form-group">
						<label for="notes">Inspiration & Design Notes</label>
						<textarea id="notes" rows="4" placeholder="Describe desired length, shape(e.g. Almond, Coffin), or design requests..."></textarea>
					</div>
					<div class="form-group full-width">
						<button type="submit" class="btn" style="width: 100%;">Confirm Appointment Request</button>
					</div>
				</form>
			</div>
		</div>
	</section>
	<!--CONTACT & INFO SECTION-->
	<section class="contact" id="contact">
		<div class="container">
			<div class="section-header">
				<h2>Get in Touch</h2>
				<p>Have questions before booking? Reach out to Mel directly at (956) 478-2118 or melanieq16661@icloud.com</p>
			</div>
			<div class="contact-grid">
			<!--Info Box-->
			<div class="contact-info-box">
				<div class="info-item">
					<i class="fa-solid fa-location-dot"></i>
					<div>
						<h4>Studio Location</h4>
						<p>South Texas Area (Private Studio)<br>22866 N FM 493 Edcouch, TX 78538.</p>
					</div>
				</div>
				<div class="info-item">
					<i class="fa-solid fa-envelope"></i>
					<div>
						<h4>Email Us</h4>
						<p>contact melanieq16661@icloud.com</p>
					</div>
				</div>
				<div class="info-item">
					<i class="fa-solid fa-clock"></i>
					<div>
						<h4>Studio Hours</h4>
						<p>Monday-Friday: 9:00AM-6:00PM<br>Saturday & Sunday: Closed</p>
					</div>
				</div>
				</div>
				<!--Social Icons-->
				<div class="social-links">
					<a href="https://instagram.com/polished_by.mel"><i class="fa-brands fa-instagram"></i></a>
					<a href="https://tiktok.com/@polished_by.mel"><i class="fa-brands fa-tiktok"></i></a>
					<a href="sms:9564782118"><i class="fa-solid fa-comment-sms"></i></a>
				</div>
			</div>
			
			<!--Simple Contact Message Box-->
			<div class="contact-info-box">
				<h3 style="margin-bottom: 20px;">Send a Direct Message</h3>
				<form onsubmit="handleMessage(event)">
					<div class="form-group" style="margin-bottom: 15px;">
						<label for="c-name">Your Name</label>
						<input type="text" id="c-name" placeholder="Your Name" required>
					</div>
					<div class="form-group" style="margin-bottom: 15px;">
						<label for="c-email">Your Email / Phone</label>
						<input type="text" id="c-email" placeholder="Email or Phone Number" required>
					</div>
					<div class="form-group" style="margin-bottom: 20px;">
						<label for="c-msg">Message</label>
						<textarea id="c-msg" rows="3" placeholder="How can Mel help you?" required></textarea>
					</div>
					<button type="submit" class="btn-outline" style="width: 100%;">Send Message</button>
				</form>
			</div>
		</div>
	</div>
</section>

<!--FOOTER-->
<footer>
	<div class="container">
		<p>&copy; 2026 <strong>Polished by Mel</strong>. Designed with <span>❤</span> for luxury nail artistry.</p>
	</div>
</footer>

	<!--UPDATED SCRIPT FOR SMS ROUTING-->
	<script>
		const MEL_PHONE_NUMBER= "19564782118";
		
		//Handles Appointment Form Submission
		function handleBooking(e) {
			e.preventDefault();
			
			const name = document.getElementById('name').value;
			const phone = document.getElementById('phone').value;
			const service = document.getElementById('service').value;
			const date = document.getElementById('date').value;
			const notes = document.getElementById('notes').value;
			
			//Format message for SMS 
			const message = `Hi Mel! I'd like to request an appointment at PolishedbyMel:%0A` +
							`.Name: ${encodeURIComponent(name)}%0A` +
							`.Phone: ${encodeURIComponent(phone)}%0A` +
							`.Service: ${encodeURIComponent (service)}%0A` +
							`.Date: ${encodeURIComponent (date)}%0A` +
							`.Notes: ${encodeURIComponent (notes || 'None')}`;
							
			//Redirect to device SMS app
			window.location.href= `sms:${MEL_PHONE_NUMBER}?body=${message}`;
		}
		
		//handles Quick Inquiry message
		function handleMessage(e) {
			e.preventDefault();
			
			const name = document.getElementById('c-name').value;
			const msg = document.getElementById('c-msg').value;
			
			const message = `Hi Mel! My name is ${encodeURIComponent(name)}.%0A%0A${encodeURIComponent(msg)}`;
			
			window.location.href = `sms:${MEL_PHONE_NUMBER}?body=${message}`;
			}
		</script>
	</body>
	</html>